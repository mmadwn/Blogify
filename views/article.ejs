<%- include('partials/header') %>
<div class="container main-content">
    <main>
        <article class="post full-article">
            <h1><%= article.title %></h1>
            <div class="post-meta">
                <span class="author">Author: <%= article.author %></span>
                <span class="category">Category: <%= article.category %></span>
                <span class="date">Date: <%= new Date(article.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
            </div>
            <% if (article.image) { %>
                <div class="post-image article-image">
                    <img src="<%= article.image %>" alt="<%= article.title %>">
                </div>
            <% } %>
            <div class="post-content">
                <%- article.content %>
            </div>
        </article>

        <section class="comments-section">
            <h3>Comments</h3>
            <% if (article.comments && article.comments.length > 0) { %>
                <ul class="comments-list">
                    <% article.comments.forEach(comment => { %>
                        <li class="comment-item">
                            <div class="comment-meta">
                                <strong><%= comment.name %></strong> -
                                <small><%= new Date(comment.createdAt).toLocaleDateString() %></small>
                            </div>
                            <p><%= comment.comment %></p>
                        </li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p>No comments yet. Be the first to comment!</p>
            <% } %>

            <h4>Add a Comment</h4>
            <form action="/article/<%= article.id %>/comment" method="POST" class="comment-form">
                <div class="form-group">
                    <label for="name">Name:</label>
                    <input type="text" id="name" name="name" required class="form-control">
                </div>
                <div class="form-group">
                    <label for="comment">Comment:</label>
                    <textarea id="comment" name="comment" required class="form-control" rows="3"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Submit Comment</button>
            </form>
        </section>
    </main>
    <aside>
        <section class="trending">
            <h3>Trending Posts</h3>
            <ul>
                <% trendingPosts.forEach(post => { %>
                    <li><a href="/article/<%= post.id %>"><%= post.title %></a></li>
                <% }) %>
            </ul>
        </section>
    </aside>
</div>
<%- include('partials/footer') %>